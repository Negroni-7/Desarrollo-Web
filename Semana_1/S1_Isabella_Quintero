<!DOCTYPE html>
<html lang="en">
<head>
  <title>Bootstrap Example</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>

<div class="container-fluid mt-3">
  <h1>Three equal width columns</h1>
  <p>Note: Try to add a new div with class="col" inside the row class - this will create four equal-width columns.</p>
  <div class="row">
    <div class="col p-1 bg-primary text-black">Ejemplo colores</div>
    <div class="col p-1 bg-dark text-white">Ejemplo Tamaño Row</div>
    <div class="col p-1 bg-primary text-black">Ejemplo uso col con -p</div>
  </div>

  <div class="row">
    <div class="bg-warning col p-2">Izquierda</div>
    <div class="bg-secondary col p-2">Derecha</div>
  </div>

  <div class="row">
    <div class="bg-secondary col p-5 ">izquierda</div>
    <div class="bg-danger col p-3">centro</div>
    <div class="bg-secondary col p-5">derecha</div>
  </div>

  <div class="row">
    <div class="bg-warning col p-2">Izquierda</div>
    <div class="bg-secondary col p-2">Derecha</div>
  </div>

  <div class="row">
    <div class="bg-danger col p-3">Linea Completa</div>
  </div>

  <div class="row">
    <div class="bg-primary col-1 p-3">1</div>
    <div class="bg-secondary col-2 p-6">2</div>
    <div class="bg-primary col-1 p-3">3</div>
    <div class="bg-secondary col-2 p-2">4</div>
    <div class="bg-primary col-3 p-2">5</div>
    <div class="bg-secondary col-1 p-3">6</div>
    <div class="bg-primary col-1 p-6">7</div>
    <div class="bg-secondary col-1 p-">8</div>
  </div>

</div>

</body>
</html>
